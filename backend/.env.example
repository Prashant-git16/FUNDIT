# ============================================================
# Fundit Server — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local development: use your local MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=fundit_user
DB_PASSWORD=your_db_password_here
DB_NAME=fundit_db

# --- JWT ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=15m

# --- Google OAuth ---
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Razorpay (TEST MODE ONLY) ---
# Obtain from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# --- AWS ---
# In production use an EC2 IAM Role (no keys needed).
# For local development only, set these:
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_for_local_dev
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_for_local_dev

# --- S3 ---
S3_BUCKET_NAME=fundit-images
# CloudFront domain for delivering campaign images (no trailing slash)
CLOUDFRONT_DOMAIN=https://your-cloudfront-distribution.cloudfront.net

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
