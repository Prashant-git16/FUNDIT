# ============================================================
# Fundit Frontend — Environment Variables Example
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: In Vite, any variable used in browser React code MUST
# be prefixed with VITE_. Other variables are ignored for security.
# ============================================================

# Google OAuth Web Client ID (from Google Cloud Console)
# If left blank, the frontend will automatically attempt to fetch it from the backend's /api/config.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
